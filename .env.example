# Newsletter
# Newsletter signup is served by hub.zentala.io (Cloudflare Workers).
# No env vars needed on this side — the POST URL is hard-coded in
# src/components/Newsletter.astro. See https://github.com/zentala/hub.

# Algolia Search Credentials
ALGOLIA_APP_ID=N0RZJY4T6S
ALGOLIA_API_KEY=<XXXXXX>
ALGOLIA_INDEX_NAME=eu_zentala_io
ALGOLIA_SEARCH_ONLY_API_KEY=<your-search-only-key>

# Public Algolia Variables (client-side)
PUBLIC_ALGOLIA_APP_ID=N0RZJY4T6S
PUBLIC_ALGOLIA_INDEX_NAME=eu_zentala_io
PUBLIC_ALGOLIA_SEARCH_ONLY_API_KEY=<your-search-only-key>