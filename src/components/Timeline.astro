---
// Timeline component for displaying a chronological roadmap
interface TimelineItem {
  period: string;
  title: string;
}

export type TimelineColor = 'blue' | 'indigo' | 'purple' | 'green' | 'teal' | 'red' | 'yellow';

export interface Props {
  title?: string;
  items: TimelineItem[];
  color?: TimelineColor;
}

const {
  title = "Vision Timeline",
  items = [
    { period: "2025-2030", title: "Infrastructure\n& Foundation" },
    { period: "2030-2035", title: "System\nIntegration" },
    { period: "2035-2045", title: "Cultural\nTransformation" }
  ],
  color = "blue"
} = Astro.props;
---

<div class="flex justify-center my-16">
  <div class="timeline-container max-w-6xl w-full p-10 rounded-xl shadow-lg" data-color={color}>
    <h2 class="timeline-title text-3xl font-bold mb-8 text-center">{title}</h2>
    <div class="flex items-center justify-between relative">
      <div class="timeline-line absolute top-1/2 left-0 right-0 h-2 transform -translate-y-1/2"></div>
      {items.map((item) => (
        <div class="timeline-item relative z-10 px-5 py-4 rounded-xl shadow-md border-2">
          <p class="font-bold text-xl">{item.period}</p>
          <p class="text-lg whitespace-pre-line">{item.title}</p>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  /* Colours come from the --card-<hue>-{bg,border,text} tokens in
     src/styles/_tokens.scss — the same triplets Card.astro uses. */
  .timeline-container {
    background-color: var(--card-blue-bg);
  }
  .timeline-container[data-color="indigo"] { background-color: var(--card-indigo-bg); }
  .timeline-container[data-color="purple"] { background-color: var(--card-purple-bg); }
  .timeline-container[data-color="green"] { background-color: var(--card-green-bg); }
  .timeline-container[data-color="teal"] { background-color: var(--card-teal-bg); }
  .timeline-container[data-color="red"] { background-color: var(--card-red-bg); }
  .timeline-container[data-color="yellow"] { background-color: var(--card-yellow-bg); }

  .timeline-title {
    color: var(--card-blue-text);
  }
  .timeline-container[data-color="indigo"] .timeline-title { color: var(--card-indigo-text); }
  .timeline-container[data-color="purple"] .timeline-title { color: var(--card-purple-text); }
  .timeline-container[data-color="green"] .timeline-title { color: var(--card-green-text); }
  .timeline-container[data-color="teal"] .timeline-title { color: var(--card-teal-text); }
  .timeline-container[data-color="red"] .timeline-title { color: var(--card-red-text); }
  .timeline-container[data-color="yellow"] .timeline-title { color: var(--card-yellow-text); }

  .timeline-line {
    background-color: var(--card-blue-border);
  }
  .timeline-container[data-color="indigo"] .timeline-line { background-color: var(--card-indigo-border); }
  .timeline-container[data-color="purple"] .timeline-line { background-color: var(--card-purple-border); }
  .timeline-container[data-color="green"] .timeline-line { background-color: var(--card-green-border); }
  .timeline-container[data-color="teal"] .timeline-line { background-color: var(--card-teal-border); }
  .timeline-container[data-color="red"] .timeline-line { background-color: var(--card-red-border); }
  .timeline-container[data-color="yellow"] .timeline-line { background-color: var(--card-yellow-border); }

  .timeline-item {
    background-color: var(--color-bg-primary);
    border-color: var(--card-blue-text);
    color: var(--color-text-primary);
  }
  .timeline-container[data-color="indigo"] .timeline-item { border-color: var(--card-indigo-text); }
  .timeline-container[data-color="purple"] .timeline-item { border-color: var(--card-purple-text); }
  .timeline-container[data-color="green"] .timeline-item { border-color: var(--card-green-text); }
  .timeline-container[data-color="teal"] .timeline-item { border-color: var(--card-teal-text); }
  .timeline-container[data-color="red"] .timeline-item { border-color: var(--card-red-text); }
  .timeline-container[data-color="yellow"] .timeline-item { border-color: var(--card-yellow-text); }
</style>
