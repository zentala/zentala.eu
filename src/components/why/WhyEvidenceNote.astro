---
/**
 * "This answer is not evidenced yet — here is what would settle it."
 *
 * The frame document says plainly that its answers to the objections still
 * need evidence attached (.plan/vision/aging-society-frame.md:124-125). Rather
 * than asserting a number nobody checked, each objection can name the thing
 * that would decide it. Styled as a quiet aside, not a warning banner.
 */
interface Props {
  /** Heading of the aside; defaults to the common case. */
  title?: string;
}

const { title = 'What would settle this' } = Astro.props;
---

<aside class="why-evidence">
  <p class="why-evidence__title">{title}</p>
  <div class="why-evidence__body"><slot /></div>
</aside>

<style>
  .why-evidence {
    max-width: 70ch;
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg-secondary);
  }

  .why-evidence__title {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin: 0 0 0.75rem;
  }

  .why-evidence__body > :global(p) {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0 0 0.75rem;
  }

  .why-evidence__body > :global(ul) {
    margin: 0;
    padding-left: 1.25rem;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .why-evidence__body > :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
