---
/**
 * Opening statement of /why: the frame the rest of the page argues from
 * (see .plan/vision/aging-society-frame.md). Kept to a readable measure and
 * set apart from the card sections by a rule rather than a coloured panel, so
 * the page opens quietly instead of with another gradient block.
 */
interface Props {
  /** Each entry is one paragraph. */
  paragraphs: string[];
  /** Short highlighted sentence closing the lead. */
  claim?: string;
}

const { paragraphs, claim } = Astro.props;
---

<div class="why-lead">
  {paragraphs.map((p) => <p class="why-lead__p">{p}</p>)}
  {claim && <p class="why-lead__claim">{claim}</p>}
</div>

<style>
  .why-lead {
    max-width: 70ch;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .why-lead__p {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0 0 1.25rem;
  }

  .why-lead__claim {
    margin: 1.75rem 0 0;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent-primary);
    font-size: var(--text-xl);
    line-height: 1.55;
    font-weight: 600;
    color: var(--color-text-primary);
  }
</style>
