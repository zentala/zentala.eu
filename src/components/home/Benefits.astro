---
// Benefits — 3 perspectives variant (E002-T07-a).
// Source of truth for copy: benefitsVariantB in
// src/pages/resources/preview/_homepage-content.ts
import DisplayTitle from '../DisplayTitle.astro';

const perspectives = [
  {
    label: 'For citizens',
    body:
      'A retirement that still works in 2050. AI healthcare that catches what tired doctors miss. Public services you do not have to physically queue for. Cross-border life that does not need a translator or a lawyer for every form.',
  },
  {
    label: 'For builders & businesses',
    body:
      'A real single market — one language, one digital identity, one regulatory surface. €507B/year of friction unlocked. Capital flows to where engineers can build at European scale instead of fragmenting into 27 sub-markets.',
  },
  {
    label: 'For nation-states',
    body:
      'Sovereignty on a stronger foundation, not a thinner one. Shared digital and robotic infrastructure costs less than building it 27 times. Strategic autonomy in defense, energy, and tech — without giving up identity.',
  },
];
---

<div
  class="py-10 mb-16 transition-colors duration-300"
  style="background: var(--color-bg-primary); border-top: 1px solid var(--color-border);"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 mt-16 mb-12">
    <DisplayTitle level={1}>Benefits</DisplayTitle>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
      {perspectives.map((p, idx) => (
        <article
          class="flex flex-col pt-6"
          style="border-top: 2px solid var(--color-accent-primary);"
        >
          <div
            class="text-sm font-mono mb-3 tracking-wide"
            style="color: var(--color-text-muted);"
          >
            {String(idx + 1).padStart(2, '0')}
          </div>
          <h3
            class="text-2xl font-semibold mb-4"
            style="color: var(--color-text-primary);"
          >
            {p.label}
          </h3>
          <p
            class="text-base leading-relaxed"
            style="color: var(--color-text-secondary);"
          >
            {p.body}
          </p>
        </article>
      ))}
    </div>
  </div>
</div>
