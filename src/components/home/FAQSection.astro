---
// FAQ section wrapper — offense-first rewrite (E002-T10).
// Source of truth: faqNew from preview content. Q2 + Q7 sharpened per editor's spec.
import FAQ from '../FAQ.astro';
import DisplayTitle from '../DisplayTitle.astro';
import { faqNew } from '../../data/homepage';

// Override Q2 (English-as-threat → reframed as absence-of-shared-language, Estonia as proof)
// and Q7 (economic euthanasia → append elderly-suicide evidence anchor).
const items = faqNew.map((item, idx) => {
  if (idx === 1) {
    return {
      question: 'Isn\'t a second official language a threat to national languages?',
      answer:
        'The threat is the opposite — the absence of a shared working language is what hollows out national ones. Without it, intra-EU migration traps people: a Polish engineer in Lisbon, a Romanian nurse in Stockholm, neither can fully participate in the country they live in nor stay tethered to the one they left. Estonia is the proof in the other direction: 30 years after adopting English as the working language for business and tech, Estonian is more alive — more published, more spoken by young people, more present online — than it was in 1991. A second official layer protects the first, it does not erode it.',
    };
  }
  if (idx === 6) {
    return {
      question: 'What is the biggest risk if we do not act?',
      answer:
        'Economic euthanasia — the slow, dignified decline of countries that did not modernize their public services in time. Pension funds run dry, hospitals run short of staff, courts stop processing, public services degrade until people stop trusting them. It does not look catastrophic from the outside. It just looks like everything getting slower, every year, until you cannot get out. The downstream signal is already documented elsewhere: Japan and South Korea, the two societies furthest into the demographic curve, both report rising suicide rates among the elderly in regions where long-term care collapsed first. That is the human cost of waiting too long to build the system.',
    };
  }
  return item;
});
---

<div class="py-10 mb-16 transition-colors duration-300" style="background: var(--color-bg-primary); border-top: 1px solid var(--color-border);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 my-16">
    <DisplayTitle level={1}>Common Questions</DisplayTitle>

    <div class="relative">
      <div class="relative">
        <FAQ color="indigo" items={items} />
      </div>
    </div>
  </div>
</div>
