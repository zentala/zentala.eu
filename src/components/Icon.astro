---
// Icon.astro - Single icon system for the whole site.
// Wraps astro-icon (Lucide set, @iconify-json/lucide) with a fixed size
// scale, currentColor stroke and sane accessibility defaults.
//
// - name: bare Lucide icon name (e.g. "globe"), resolved as "lucide:<name>"
// - size: constrained to the 16/20/24/32 scale used across the site
// - label: when set, the icon gets an accessible name (role="img" +
//   aria-label) and is treated as meaningful; otherwise it stays
//   aria-hidden="true" (decorative, paired with visible text)
import { Icon as AstroIcon } from 'astro-icon/components'

type IconSize = 16 | 20 | 24 | 32

interface Props {
  name: string
  size?: IconSize
  label?: string
  class?: string
}

const { name, size = 24, label, class: className } = Astro.props

const iconName = name.includes(':') ? name : `lucide:${name}`
---

<AstroIcon
  name={iconName}
  width={size}
  height={size}
  class={className}
  color="currentColor"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  focusable="false"
/>
