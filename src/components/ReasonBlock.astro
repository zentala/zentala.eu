---
interface Props {
  number: number;
  icon: string;
  title: string;
  paragraphs: string[];
  highlight?: string;
  color?: 'blue' | 'indigo' | 'teal';
}

const { number, icon, title, paragraphs, highlight, color = "blue" } = Astro.props;
---

<div class="mb-12 md:mb-16 flex flex-col md:flex-row gap-4 md:gap-8 relative">
  <div class="flex-shrink-0 flex items-start">
    <div class="reason-number w-12 h-12 rounded-full flex items-center justify-center text-2xl font-bold shadow-lg z-10" data-color={color}>{number}</div>
  </div>
  <div class="reason-block flex-grow backdrop-blur-sm rounded-xl p-6 border transition-all shadow-md" data-color={color}>
    <h3 class="reason-title text-2xl font-bold mb-4 flex items-center">
      <span class="mr-3 text-2xl">{icon}</span>
      {title}
    </h3>
    {paragraphs.map((paragraph) => (
      <p class="reason-text mb-4 leading-relaxed">
        {paragraph}
      </p>
    ))}
    {highlight && (
      <div class="reason-highlight p-4 rounded-lg border-l-4" data-color={color}>
        <p class="reason-text leading-relaxed">
          <span class="reason-highlight-text font-semibold">{highlight}</span>
        </p>
      </div>
    )}
  </div>
</div>

<style>
  /* Colours come from the --card-<hue>-{bg,border,text} tokens in
     src/styles/_tokens.scss — the same triplets Card.astro uses. */
  .reason-number {
    background-color: var(--card-blue-text);
    color: var(--color-bg-primary);
  }
  .reason-number[data-color="indigo"] { background-color: var(--card-indigo-text); }
  .reason-number[data-color="teal"] { background-color: var(--card-teal-text); }

  .reason-block {
    background-color: var(--card-blue-bg);
    border-color: var(--card-blue-border);
    color: var(--card-blue-text);
  }
  .reason-block[data-color="indigo"] { background-color: var(--card-indigo-bg); border-color: var(--card-indigo-border); color: var(--card-indigo-text); }
  .reason-block[data-color="teal"] { background-color: var(--card-teal-bg); border-color: var(--card-teal-border); color: var(--card-teal-text); }
  .reason-block:hover {
    filter: brightness(0.98);
  }
  :global(.dark) .reason-block:hover {
    filter: brightness(1.1);
  }

  .reason-title,
  .reason-text,
  .reason-highlight-text {
    color: inherit;
  }
  .reason-text {
    opacity: 0.9;
  }

  .reason-highlight {
    background-color: var(--color-bg-primary);
    border-color: var(--card-blue-text);
  }
  .reason-highlight[data-color="indigo"] { border-color: var(--card-indigo-text); }
  .reason-highlight[data-color="teal"] { border-color: var(--card-teal-text); }
</style>
