---
/**
 * SourceRef — inline citation widget for research sources.
 *
 * Renders a small badge linked to a popover (desktop) or bottom sheet (mobile)
 * with the source title, summary, and a link to the full research file.
 *
 * Data resolves at build time from the existing `docs` content collection.
 * Invalid slugs throw at build — typos in callers fail `npm run build` loudly.
 *
 * Behavior, tokens, and a11y spec: see DESIGN.md.
 */
import { getEntry } from 'astro:content';

interface Props {
  /** Slug under src/content/docs/, e.g. "research/t1-1-demographic-crisis" */
  slug: string;
  /** Optional override for badge label. Defaults to research file title. */
  cite?: string;
}

const { slug, cite } = Astro.props;

const entry = await getEntry('docs', slug);
if (!entry) {
  throw new Error(
    `SourceRef: source slug "${slug}" not found in docs collection. ` +
      `Check that src/content/docs/${slug}.md exists with valid frontmatter.`,
  );
}

const title = entry.data.title;
const description = entry.data.description;
const href = `/${slug}`;
const label = cite ?? title;

// Stable popover id per slug — multiple refs to the same source share state.
const popoverId = `source-ref-${slug.replace(/[^a-z0-9]+/gi, '-')}`;
---

<span class="source-ref">
  <button
    type="button"
    class="source-ref-badge"
    popovertarget={popoverId}
    aria-label={`Source: ${label}`}
  >
    <sup>[{label}]</sup>
  </button>
  <div id={popoverId} popover="auto" class="source-ref-popover" role="dialog">
    <p class="source-ref-title">{title}</p>
    <p class="source-ref-description">{description}</p>
    <a href={href} class="source-ref-link">Read source &rarr;</a>
  </div>
</span>

<style>
  .source-ref {
    display: inline;
  }

  .source-ref-badge {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    color: var(--color-text-muted);
    cursor: pointer;
    font-family: inherit;
    line-height: 1;
    transition: color 0.15s;
  }

  .source-ref-badge:hover,
  .source-ref-badge:focus-visible {
    color: var(--color-accent-primary);
    outline: none;
  }

  .source-ref-badge:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .source-ref-badge sup {
    font-size: 0.7em;
    font-weight: 500;
  }

  /* Native HTML Popover — desktop default positioning above badge */
  .source-ref-popover {
    max-width: 22rem;
    padding: 1rem 1.25rem;
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    margin: 0;
  }

  .source-ref-title {
    font-weight: 600;
    margin: 0 0 0.5rem;
    font-size: 1rem;
    line-height: 1.4;
  }

  .source-ref-description {
    color: var(--color-text-secondary);
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .source-ref-link {
    color: var(--color-accent-primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .source-ref-link:hover {
    text-decoration: underline;
  }

  /* Mobile: pin to bottom of viewport as a sheet */
  @media (max-width: 639px) {
    .source-ref-popover {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      top: auto;
      max-width: none;
      width: 100%;
      border-radius: 1rem 1rem 0 0;
      padding: 1.5rem;
      margin: 0;
      animation: source-ref-slide-up 0.2s ease-out;
    }
  }

  @keyframes source-ref-slide-up {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  /* Touch target padding on mobile so the badge is at least 44px tappable */
  @media (max-width: 639px) {
    .source-ref-badge {
      padding: 0.25rem 0.375rem;
      min-width: 44px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>
