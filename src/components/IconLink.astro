---
// IconLink.astro - A reusable component for creating links with a Lucide icon.
import Icon from './Icon.astro'

interface Props {
  href: string
  icon: string // Lucide icon name, e.g. "globe", "book"
  iconPosition?: 'left' | 'right'
  class?: string
  ariaLabel?: string
  target?: string
}

const {
  href,
  icon,
  iconPosition = 'left',
  class: className = '',
  ariaLabel,
  target,
} = Astro.props

// Base classes
let classes = 'inline-flex items-center gap-2 transition-colors duration-200'

// Apply custom classes
classes = `${classes} ${className}`
---

<a
  href={href}
  class={classes}
  aria-label={ariaLabel}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
>
  {iconPosition === 'left' && <Icon name={icon} size={20} />}

  <span><slot /></span>

  {iconPosition === 'right' && <Icon name={icon} size={20} />}
</a>
