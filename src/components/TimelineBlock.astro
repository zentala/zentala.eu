---
interface Props {
  number: number;
  icon: string;
  title: string;
  paragraphs: string[];
  highlight?: string;
  accentColor?: string;
}

const { number, icon, title, paragraphs, highlight, accentColor = "blue" } = Astro.props;

// Accent hue must be one of the --card-<hue>-* tokens in src/styles/_tokens.scss
const accent = (["blue", "indigo", "teal"].includes(accentColor) ? accentColor : "blue") as
  "blue" | "indigo" | "teal";
---

<!-- Spacing between blocks is owned by TimelineContainer's `gap`, which the
     connector-line maths depends on — do not re-add a margin here. -->
<div class="flex flex-col md:flex-row gap-4 md:gap-8 relative timeline-block" data-accent={accent}>
  <div class="flex-shrink-0 flex items-start">
    <div class="number-badge w-12 h-12 rounded-full flex items-center justify-center text-2xl font-bold text-white shadow-md z-10">{number}</div>
  </div>
  <div class="block-body flex-grow backdrop-blur-sm rounded-lg p-6 border transition-all shadow-sm">
    <h3 class="block-title text-2xl font-bold mb-4 flex items-center">
      <span class="mr-3 text-2xl">{icon}</span>
      {title}
    </h3>
    {paragraphs.map((paragraph) => (
      <p class="block-text mb-4 leading-relaxed">
        {paragraph}
      </p>
    ))}
    {highlight && (
      <div class="highlight-box p-4 rounded-md border-l-4">
        <p class="block-text leading-relaxed">
          <span class="highlight-text font-semibold">{highlight}</span>
        </p>
      </div>
    )}
  </div>
</div>

<style>
  /* Colours come from the --card-<hue>-{bg,border,text} tokens
     (src/styles/_tokens.scss) — same source as Card.astro — so the timeline
     never hardcodes a Tailwind shade and stays correct in both themes. */
  .timeline-block {
    --hue-bg: var(--card-blue-bg);
    --hue-border: var(--card-blue-border);
    --hue-text: var(--card-blue-text);
  }
  .timeline-block[data-accent="indigo"] {
    --hue-bg: var(--card-indigo-bg);
    --hue-border: var(--card-indigo-border);
    --hue-text: var(--card-indigo-text);
  }
  .timeline-block[data-accent="teal"] {
    --hue-bg: var(--card-teal-bg);
    --hue-border: var(--card-teal-border);
    --hue-text: var(--card-teal-text);
  }

  .number-badge {
    background-image: linear-gradient(to bottom right, var(--color-accent-primary), var(--hue-text));
  }

  .block-body {
    background-color: var(--color-bg-primary);
    border-color: var(--color-border);
  }
  .block-body:hover {
    border-color: var(--hue-border);
  }

  .block-title {
    color: var(--color-text-primary);
  }

  .block-text {
    color: var(--color-text-secondary);
  }

  .highlight-box {
    background-color: var(--hue-bg);
    border-color: var(--hue-border);
  }

  .highlight-text {
    color: var(--hue-text);
  }
</style>
