---
/**
 * ChapterFooter — the generated cross-link block that closes every published
 * chapter (E006-T11, IA §6 rule 1; DESIGN.md "ChapterFooter"). Replaces the
 * 13 hand-written italic "Part of the EU Reform Vision..." paragraphs
 * (deleted by the wave-5 editorial tasks): nothing here is authored per
 * chapter, everything is derived from `layer` / `order` / `concepts`.
 *
 * Four parts, any of which can be empty and is then omitted:
 * - In this layer: previous/next by `order` inside the same `layer`.
 * - Up: the layer's label, linking to `/vision#<layer>`.
 * - Related: up to three chapters sharing the most `concepts`, excluding
 *   prev/next, ties broken by `order`. Omitted when nothing is shared —
 *   `concepts` ships empty until E006-T05 populates it in this same wave.
 * - Carry this: one fixed line linking `/manifesto` and `/support`.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { IS_PREVIEW } from '../lib/preview';
import type { Layer } from '../content/config';

interface Props {
  /** The chapter this footer closes. */
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;

const LAYER_LABELS: Record<Layer, string> = {
  frame: 'The frame',
  language: 'Floor — one working language',
  digital: 'Middle — the digital state',
  robotics: 'Ceiling — robotics',
  path: 'How we get there',
};

const chapters = await getCollection('docs', (candidate: CollectionEntry<'docs'>) => {
  const isBook = candidate.id.startsWith('book/') && !candidate.id.includes('.sidecar');
  return isBook && (IS_PREVIEW || !candidate.data.draft);
});

interface ChapterRef {
  slug: string;
  title: string;
}

function toRef(candidate: CollectionEntry<'docs'>): ChapterRef {
  return { slug: candidate.slug.replace(/^book\//, ''), title: candidate.data.title };
}

const layer = entry.data.layer;
const order = entry.data.order;

// In this layer: previous/next by order, inside the same layer only — the
// frame's last chapter does not "continue" into the floor; the layer anchor
// does that.
const layerSiblings = layer
  ? chapters
      .filter((candidate) => candidate.data.layer === layer && candidate.id !== entry.id)
      .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity) || a.data.title.localeCompare(b.data.title))
  : [];

const previous =
  layer && order !== undefined
    ? layerSiblings.filter((candidate) => (candidate.data.order ?? Infinity) < order).pop()
    : undefined;
const next =
  layer && order !== undefined
    ? layerSiblings.find((candidate) => (candidate.data.order ?? Infinity) > order)
    : undefined;

const previousRef = previous ? toRef(previous) : undefined;
const nextRef = next ? toRef(next) : undefined;

// Related: up to three chapters sharing the most concepts, excluding prev/next.
const ownConcepts = new Set(entry.data.concepts.map((concept) => concept.slug));
const excludedIds = new Set([entry.id, previous?.id, next?.id].filter(Boolean) as string[]);

const related = ownConcepts.size
  ? chapters
      .filter((candidate) => !excludedIds.has(candidate.id))
      .map((candidate) => {
        const shared = candidate.data.concepts.filter((concept) => ownConcepts.has(concept.slug)).length;
        return { candidate, shared };
      })
      .filter(({ shared }) => shared > 0)
      .sort((a, b) => b.shared - a.shared || (a.candidate.data.order ?? Infinity) - (b.candidate.data.order ?? Infinity))
      .slice(0, 3)
      .map(({ candidate }) => toRef(candidate))
  : [];
---

<footer class="chapter-footer">
  {(previousRef || nextRef) && (
    <nav class="chapter-footer__row" aria-label="In this layer">
      <p class="chapter-footer__label">In this layer</p>
      <div class="chapter-footer__prev-next">
        {previousRef && (
          <a href={`/book/${previousRef.slug}/`} class="chapter-footer__link chapter-footer__link--prev">
            &larr; {previousRef.title}
          </a>
        )}
        {nextRef && (
          <a href={`/book/${nextRef.slug}/`} class="chapter-footer__link chapter-footer__link--next">
            {nextRef.title} &rarr;
          </a>
        )}
      </div>
    </nav>
  )}

  {layer && (
    <p class="chapter-footer__row">
      <span class="chapter-footer__label">Up</span>{' '}
      <a href={`/vision#${layer}`} class="chapter-footer__link">{LAYER_LABELS[layer]}</a>
    </p>
  )}

  {related.length > 0 && (
    <div class="chapter-footer__row">
      <p class="chapter-footer__label">Related</p>
      <ul class="chapter-footer__related">
        {related.map((ref) => (
          <li><a href={`/book/${ref.slug}/`} class="chapter-footer__link">{ref.title}</a></li>
        ))}
      </ul>
    </div>
  )}

  <p class="chapter-footer__row chapter-footer__carry">
    Carry this: read the <a href="/manifesto" class="chapter-footer__link">manifesto</a>, or turn it into <a href="/support" class="chapter-footer__link">support</a>.
  </p>
</footer>

<style>
  .chapter-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .chapter-footer__row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .chapter-footer__label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .chapter-footer__prev-next {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .chapter-footer__link {
    color: var(--color-accent-primary);
    text-decoration: none;
  }

  .chapter-footer__link:hover {
    text-decoration: underline;
  }

  .chapter-footer__related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .chapter-footer__carry {
    color: var(--color-text-secondary);
  }
</style>
