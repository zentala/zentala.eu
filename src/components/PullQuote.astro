---
/**
 * PullQuote — one sentence from the chapter, set in H3 serif, pulled into
 * the margin or the column as a landmark for a scanning reader. Verbatim
 * from the surrounding text, at most one per 1,000 words.
 *
 * DESIGN.md → Components → "PullQuote": no quotation marks, no left bar.
 * Uses a plain paragraph rather than `<blockquote>` so it never inherits
 * `.prose blockquote`'s italic/left-rule styling (`global.scss`) — this is
 * a repeated landmark sentence, not a quotation from another source.
 */
interface Props {
  aside?: boolean;
}

const { aside = false } = Astro.props;
---

<p class="pull-quote" data-aside={aside}>
  <slot />
</p>

<style>
  .pull-quote {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 400;
    font-style: normal;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin: var(--space-2xl) 0;
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .pull-quote[data-aside='true'] {
    max-width: 22rem;
  }

  @media (min-width: 1024px) {
    .pull-quote[data-aside='true'] {
      float: right;
      margin-left: var(--space-xl);
    }
  }
</style>
