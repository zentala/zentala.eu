---
/**
 * ProvenanceNote — the required record of where a chapter's passages came
 * from: which dump, what the author dictated, what an agent added (and
 * whether he has adopted it), what was cut, and which questions are still
 * open. Renders the five fields the editorial standard requires.
 *
 * Contract: DESIGN.md → Components → "ProvenanceNote" gives the visual
 * shape (a stamp, not a warning — no red, no icon); `src/AGENTS.md` §3
 * "What the ProvenanceNote must say" gives the fields themselves, which
 * supersede DESIGN.md's earlier `kind`/`by`/`date` sketch: Source,
 * Dictated, Added, Cut, Open.
 */
type Field = string | string[];

interface Props {
  /** Which dump(s), with date, file name and the line range drawn on. */
  source: Field;
  /** What the author actually said — claims, instructions, questions asked. */
  dictated: Field;
  /** What an agent supplied, each item's status: "proposed" or "adopted <date>". */
  added: Field;
  /** What was dictated and left out, and why. */
  cut?: Field;
  /** Unanswered ASK-n items, by number. */
  open?: Field;
}

const { source, dictated, added, cut, open } = Astro.props;

function toList(field: Field): string[] {
  return Array.isArray(field) ? field : [field];
}

const fields: { label: string; items: string[] }[] = [
  { label: 'Source', items: toList(source) },
  { label: 'Dictated', items: toList(dictated) },
  { label: 'Added', items: toList(added) },
  ...(cut ? [{ label: 'Cut', items: toList(cut) }] : []),
  ...(open ? [{ label: 'Open', items: toList(open) }] : []),
];
---

<dl class="provenance-note">
  {fields.map((field) => (
    <div class="provenance-note__field">
      <dt class="provenance-note__label">{field.label}</dt>
      <dd class="provenance-note__value">
        {field.items.length > 1 ? (
          <ul>
            {field.items.map((item) => <li>{item}</li>)}
          </ul>
        ) : (
          field.items[0]
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  .provenance-note {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
  }

  .provenance-note__field {
    display: flex;
    gap: var(--space-sm);
    margin: 0;
  }

  .provenance-note__label {
    flex-shrink: 0;
    width: 5rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .provenance-note__value {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .provenance-note__value ul {
    list-style: disc;
    margin: 0;
    padding-left: var(--space-md);
  }

  .provenance-note__value li {
    margin: 0 0 0.2rem;
  }

  .provenance-note__value li:last-child {
    margin-bottom: 0;
  }
</style>
