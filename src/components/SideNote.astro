---
/**
 * SideNote — a short aside in the right margin: a source, a translation, a
 * caveat, a pointer to the chapter that argues the point in full. Replaces
 * full restatement of an argument with a two-sentence summary and a link.
 *
 * DESIGN.md → Components → "SideNote". Floats beside the preceding
 * paragraph on wide screens (the same placement `EvidenceBox` and
 * `KeyFigure aside` use); below 1024px it is an indented paragraph in the
 * normal flow, so it still reads in sequence.
 */
interface Props {
  /** Eyebrow label, e.g. "Source", "Argued in full". */
  label?: string;
}

const { label } = Astro.props;
---

<aside class="side-note">
  {label && <p class="side-note__label">{label}</p>}
  <div class="side-note__body"><slot /></div>
</aside>

<style>
  .side-note {
    max-width: 22rem;
    margin: var(--space-lg) 0;
    padding-left: var(--space-md);
    border-left: 1px solid var(--color-border);
  }

  @media (min-width: 1024px) {
    .side-note {
      float: right;
      margin-left: var(--space-xl);
      margin-top: 0;
    }
  }

  .side-note__label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 0.35rem;
  }

  .side-note__body {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .side-note__body :global(p) {
    margin: 0 0 0.5rem;
  }

  .side-note__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .side-note__body :global(a) {
    color: var(--color-accent-primary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
