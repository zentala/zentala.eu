---
/**
 * LayerCard — one level of the stack.
 * Shows the level number, its position (floor / middle / ceiling), the claim,
 * the concrete points, and a link to the existing detail page.
 */
import type { Layer, LayerTone } from './types';

type Props = Layer;

const { level, position, title, summary, points, href, linkText, tone } = Astro.props;
---

<article class="layer rounded-2xl border-2 p-6 sm:p-8 shadow-lg" data-tone={tone} id={`layer-${level}`}>
  <header class="flex items-center gap-4 mb-4">
    <span class="layer-badge flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-xl font-bold" aria-hidden="true">
      {level}
    </span>
    <div>
      <p class="position text-xs font-semibold uppercase tracking-widest">Level {level} · {position}</p>
      <h3 class="text-2xl sm:text-3xl font-bold leading-tight">{title}</h3>
    </div>
  </header>

  <p class="text-lg leading-relaxed mb-5">{summary}</p>

  <ul class="space-y-2 text-base sm:text-lg">
    {points.map((point) => (
      <li class="flex gap-3">
        <span class="layer-bullet flex-shrink-0" aria-hidden="true">▸</span>
        <span>{point}</span>
      </li>
    ))}
  </ul>

  <a href={href} class="read-more inline-flex items-center gap-1 mt-6 font-medium group">
    {linkText}
    <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
  </a>
</article>

<style>
  /* Colours come from the --card-<hue>-{bg,border,text} tokens in
     src/styles/_tokens.scss — the same triplets Card.astro uses. */
  .layer {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border-color: var(--card-indigo-border);
  }
  .layer[data-tone="blue"] { border-color: var(--card-blue-border); }
  .layer[data-tone="green"] { border-color: var(--card-green-border); }

  .position {
    color: var(--color-text-secondary);
  }
  .read-more {
    /* accent-primary, not -secondary: falls short of 4.5:1 on the card
       background in light theme (E004-T01). */
    color: var(--color-accent-primary);
  }

  .layer-badge {
    background-color: var(--card-indigo-text);
    color: var(--color-bg-primary);
  }
  .layer[data-tone="blue"] .layer-badge { background-color: var(--card-blue-text); }
  .layer[data-tone="green"] .layer-badge { background-color: var(--card-green-text); }

  .layer-bullet {
    color: var(--card-indigo-text);
  }
  .layer[data-tone="blue"] .layer-bullet { color: var(--card-blue-text); }
  .layer[data-tone="green"] .layer-bullet { color: var(--card-green-text); }
</style>
