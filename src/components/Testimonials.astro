---
interface TestimonialItem {
  quote: string;
  author: string;
  title: string;
  organization?: string;
  avatar?: string;
}

interface Props {
  items: TestimonialItem[];
  color?: 'gray' | 'blue' | 'indigo' | 'purple';
}

const { items, color = "blue" } = Astro.props;
---

<div class="testimonials-container">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {items.map((item) => (
      <div class="testimonial-card border rounded-xl p-6 shadow-lg" data-color={color}>
        <div class="mb-6">
          <svg class="testimonial-quote-icon h-8 w-8 mb-2" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="testimonial-quote text-lg italic leading-relaxed">{item.quote}</p>
        </div>

        <div class="flex items-center">
          {item.avatar ? (
            <div class="mr-4 flex-shrink-0">
              <div class="testimonial-avatar w-12 h-12 rounded-full overflow-hidden border-2">
                <img src={item.avatar} alt={item.author} class="w-full h-full object-cover" />
              </div>
            </div>
          ) : (
            <div class="mr-4 flex-shrink-0">
              <div class="testimonial-avatar-fallback w-12 h-12 rounded-full border-2 flex items-center justify-center" data-color={color}>
                <span class="text-lg font-semibold">{item.author.substring(0, 1)}</span>
              </div>
            </div>
          )}

          <div>
            <p class="testimonial-author font-semibold">{item.author}</p>
            <p class="testimonial-role text-sm">
              {item.title}
              {item.organization && (
                <span>, {item.organization}</span>
              )}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  /* Colours come from the --card-<hue>-{bg,border,text} tokens in
     src/styles/_tokens.scss — the same triplets Card.astro uses. */
  .testimonial-card {
    background-color: var(--card-gray-bg);
    border-color: var(--card-gray-border);
    color: var(--card-gray-text);
  }
  .testimonial-card[data-color="blue"] { background-color: var(--card-blue-bg); border-color: var(--card-blue-border); color: var(--card-blue-text); }
  .testimonial-card[data-color="indigo"] { background-color: var(--card-indigo-bg); border-color: var(--card-indigo-border); color: var(--card-indigo-text); }
  .testimonial-card[data-color="purple"] { background-color: var(--card-purple-bg); border-color: var(--card-purple-border); color: var(--card-purple-text); }

  .testimonial-quote-icon,
  .testimonial-quote,
  .testimonial-author {
    color: inherit;
  }
  .testimonial-quote {
    opacity: 0.9;
  }
  .testimonial-role {
    color: inherit;
    opacity: 0.7;
  }

  .testimonial-avatar {
    border-color: var(--color-border);
  }

  .testimonial-avatar-fallback {
    background-color: var(--card-gray-bg);
    border-color: var(--card-gray-border);
    color: var(--card-gray-text);
  }
  .testimonial-avatar-fallback[data-color="blue"] { background-color: var(--card-blue-bg); border-color: var(--card-blue-border); color: var(--card-blue-text); }
  .testimonial-avatar-fallback[data-color="indigo"] { background-color: var(--card-indigo-bg); border-color: var(--card-indigo-border); color: var(--card-indigo-text); }
  .testimonial-avatar-fallback[data-color="purple"] { background-color: var(--card-purple-bg); border-color: var(--card-purple-border); color: var(--card-purple-text); }
</style>
