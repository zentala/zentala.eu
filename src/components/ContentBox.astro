---
type BoxColor = 'blue' | 'indigo' | 'green' | 'red' | 'purple' | 'teal';

interface Props {
  title?: string;
  color?: BoxColor;
}

const { title, color = 'blue' } = Astro.props;
---

<div
  class="content-box p-4 rounded-lg transition-colors duration-300"
  data-color={color}
>
  {title && <h4 class="font-bold mb-2 title-text">{title}</h4>}
  <div class="content-text">
    <slot />
  </div>
</div>

<style>
  /* Colours come from the --card-<hue>-{bg,text} tokens in
     src/styles/_tokens.scss — the same triplets Card.astro uses. */
  .content-box {
    background-color: var(--card-blue-bg);
  }
  .content-box .title-text {
    color: var(--card-blue-text);
  }

  .content-box[data-color="indigo"] { background-color: var(--card-indigo-bg); }
  .content-box[data-color="indigo"] .title-text,
  .content-box[data-color="indigo"] a { color: var(--card-indigo-text); }

  .content-box[data-color="green"] { background-color: var(--card-green-bg); }
  .content-box[data-color="green"] .title-text,
  .content-box[data-color="green"] a { color: var(--card-green-text); }

  .content-box[data-color="red"] { background-color: var(--card-red-bg); }
  .content-box[data-color="red"] .title-text,
  .content-box[data-color="red"] a { color: var(--card-red-text); }

  .content-box[data-color="purple"] { background-color: var(--card-purple-bg); }
  .content-box[data-color="purple"] .title-text,
  .content-box[data-color="purple"] a { color: var(--card-purple-text); }

  .content-box[data-color="teal"] { background-color: var(--card-teal-bg); }
  .content-box[data-color="teal"] .title-text,
  .content-box[data-color="teal"] a { color: var(--card-teal-text); }

  .content-box .content-text {
    color: var(--color-text-secondary);
  }

  .content-box a {
    color: var(--card-blue-text);
    transition: filter 0.2s;
  }
  .content-box a:hover {
    filter: brightness(1.2);
  }
  :global(.dark) .content-box a:hover {
    filter: brightness(1.3);
  }
</style>
