---
// Newsletter component for collecting email subscriptions
---

<div class="relative">
  <div class="absolute inset-0 newsletter-glow opacity-20 blur-xl"></div>
  <div class="relative newsletter-container border rounded-xl p-8 shadow-lg">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="newsletter-title text-2xl font-bold mb-4">Subscribe to Our Newsletter</h2>
      <p class="newsletter-text mb-6">Join our community of forward-thinking Europeans. Get updates on the latest developments and be part of shaping Europe's digital future.</p>

      <form class="flex flex-col sm:flex-row gap-4 justify-center mb-4" id="newsletter-form">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          placeholder="Your email address"
          class="newsletter-input px-4 py-3 rounded-lg border w-full sm:w-auto sm:flex-1 max-w-md"
        />
        <button
          type="submit"
          class="newsletter-button px-6 py-3 font-medium rounded-lg transition-colors duration-300"
        >
          Subscribe
        </button>
      </form>
      <p class="newsletter-hint text-sm">We respect your privacy. Unsubscribe at any time.</p>
    </div>
  </div>
</div>

<style>
  /* Colours come from the --card-<hue>-{bg,border,text} and
     --color-* tokens in src/styles/_tokens.scss. */
  .newsletter-glow {
    background-image: linear-gradient(to right, var(--card-blue-bg), var(--card-indigo-bg));
  }

  .newsletter-container {
    background-color: var(--card-blue-bg);
    border-color: var(--card-blue-border);
    color: var(--card-blue-text);
  }

  .newsletter-title {
    color: inherit;
  }
  .newsletter-text {
    color: inherit;
    opacity: 0.9;
  }
  .newsletter-hint {
    color: inherit;
    opacity: 0.85;
  }

  .newsletter-input {
    background-color: var(--color-bg-primary);
    border-color: var(--color-border);
    color: var(--color-text-primary);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .newsletter-input:focus {
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 2px var(--color-accent-primary);
  }

  .newsletter-button {
    background-color: var(--color-accent-primary);
    color: var(--color-bg-primary);
  }
  .newsletter-button:hover {
    background-color: var(--color-accent-secondary);
  }
</style>

<script>
  // Client-side form handling
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('#newsletter-form');

    // Check if form exists before adding event listener
    if (!form) {
      console.error('Newsletter form not found');
      return;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement;

      // Check if email input exists
      if (!emailInput) {
        console.error('Email input not found');
        return;
      }

      const email = emailInput.value;

      try {
        const res = await fetch('https://cloud.appwrite.io/v1/functions/{import.meta.env.PUBLIC_APPWRITE_NEWSLETTER_FUNCTION_ID}/executions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await res.json();
        alert(data.message || 'Sprawdź swoją skrzynkę!');
        emailInput.value = '';
      } catch (error) {
        console.error('Error submitting form:', error);
        alert('An error occurred while subscribing. Please try again later.');
      }
    });
  });
</script>
