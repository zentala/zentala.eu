---
/**
 * Vertical timeline surface. Colours come from the theme tokens in
 * src/styles/_tokens.scss — never a raw Tailwind shade and never a `dark:`
 * variant: `darkMode` is unset in tailwind.config.mjs, so `dark:` follows the
 * OS preference and paints a dark slab onto the site's light theme.
 *
 * The connector line is drawn per block (see the `:not(:last-child)` rule
 * below) rather than once across the whole column, so it runs from one
 * numbered circle to the next and stops at the last circle instead of
 * trailing past it.
 */
---

<div class="timeline-container rounded-xl p-6 md:p-8">
  <div class="timeline-track">
    <slot />
  </div>
</div>

<style>
  .timeline-container {
    /* Gap between blocks; the connector maths below reads the same value. */
    --timeline-gap: 3rem;
    /* Half the 3rem numbered circle — where the line starts and ends. */
    --timeline-badge-center: 1.5rem;
    /* Circle column centre (1.45rem) minus half the 2px line. */
    --timeline-line-x: 1.39rem;

    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .timeline-track {
    display: flex;
    flex-direction: column;
    gap: var(--timeline-gap);
  }

  /* Desktop only: on mobile the circle sits above the card, so a vertical
     rail through the left gutter would point at nothing. */
  @media (min-width: 768px) {
    .timeline-track > :global(.timeline-block) {
      position: relative;
    }

    .timeline-track > :global(.timeline-block:not(:last-child))::before {
      content: '';
      position: absolute;
      left: var(--timeline-line-x);
      top: var(--timeline-badge-center);
      /* Reach the NEXT circle's centre: past this block's bottom edge, across
         the gap, down to the middle of the following badge. */
      bottom: calc(-1 * (var(--timeline-gap) + var(--timeline-badge-center)));
      width: 2px;
      border-radius: var(--radius-full);
      background-color: var(--color-border);
    }
  }
</style>
