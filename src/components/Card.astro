---
import Icon from './Icon.astro';
import Surface, { type SurfaceHue, type SurfaceVariant } from './Surface.astro';

type CardAlignment = 'center' | 'left';

interface Props {
	icon?: string;
	title: string;
	color?: SurfaceHue;
	href?: string;
	linkText?: string;
	variant?: SurfaceVariant;
	align?: CardAlignment;
}

const {
	icon,
	title,
	color = 'gray',
	href,
	linkText = 'Learn more',
	variant = 'flat',
	align = 'left'
} = Astro.props;

const alignmentClasses = {
	center: 'text-center',
	left: 'text-left'
};

const cardClass = `
	card flex flex-col gap-4 p-8 rounded-lg shadow-md
	transition-all duration-300 hover:shadow-lg
	transform hover:scale-[1.02] h-full
	${alignmentClasses[align]}
`;

const titleClass = `title font-bold text-2xl leading-snug gap-2 mb-4 ${align === 'center' ? 'flex-col' : ''} flex ${align === 'center' ? 'justify-center' : 'justify-start'} items-center`;

const iconClass = `inline-flex ${align === 'center' ? 'mb-2' : ''}`;

const linkClass = `text-current hover:opacity-80 font-medium flex items-center group mt-4 ${align === 'center' ? 'justify-center' : 'justify-start'}`;
---

<Surface as="article" hue={color} variant={variant} class={cardClass} data-align={align}>
	<h3 class={titleClass}>
		{icon && <span class={iconClass}><Icon name={icon} size={32} /></span>}
		<span set:html={title} />
	</h3>

	<div class="body text-lg flex-grow">
		<slot />
	</div>

	{href && (
		<a href={href} class={linkClass}>
			{linkText}
			<span class="ml-1 group-hover:translate-x-1 transition-transform inline-flex items-center">
				<Icon name="arrow-right" size={20} />
			</span>
		</a>
	)}
</Surface>

<style>
  .card:hover {
    filter: brightness(0.97);
  }
  :global(.dark) .card:hover {
    filter: brightness(1.12);
  }

  /* Body text inherits the surface's own hue-text token instead of the
     site-wide secondary grey, so contrast stays correct against every hue. */
  .card .body {
    color: inherit;
    opacity: 0.92;
  }

  .card .body :global(strong) {
    color: inherit;
  }

  .card a {
    margin-top: auto;
  }

  .card[data-align="center"] .title {
    flex-direction: column;
    text-align: center;
  }

  .card[data-align="left"] .title {
    flex-direction: row;
    text-align: left;
  }
</style>
