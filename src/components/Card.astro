---
import Icon from './Icon.astro';
import Surface, { type SurfaceHue } from './Surface.astro';

type CardVariant = 'default' | 'bordered';

interface Props {
	icon?: string;
	title: string;
	color?: SurfaceHue;
	href?: string;
	linkText?: string;
	variant?: CardVariant;
}

const {
	icon,
	title,
	color = 'gray',
	href,
	linkText = 'Learn more',
	variant = 'default'
} = Astro.props;

const surfaceVariant = variant === 'bordered' ? 'bordered' : 'flat';

const cardClass = `
	card flex flex-col gap-4 p-8 rounded-md shadow-sm
	transition-shadow duration-300 hover:shadow-md h-full text-left
`;
---

<Surface as="article" hue={color} variant={surfaceVariant} class={cardClass}>
	<h3 class="title font-bold text-2xl leading-snug gap-2 mb-4 flex justify-start items-center">
		{icon && <span class="inline-flex"><Icon name={icon} size={32} /></span>}
		<span set:html={title} />
	</h3>

	<div class="body text-lg flex-grow">
		<slot />
	</div>

	{href && (
		<a href={href} class="text-current hover:opacity-80 font-medium flex items-center group mt-4 justify-start">
			{linkText}
			<span class="ml-1 group-hover:translate-x-1 transition-transform inline-flex items-center">
				<Icon name="arrow-right" size={20} />
			</span>
		</a>
	)}
</Surface>

<style>
  /* Hover state per DESIGN.md: shadow-md (via the hover:shadow-md class
     above) and the border moves to the hue's own text token. Surface
     already sets `color` to that token per hue, so currentColor picks it
     up without a per-hue rule here. No scale, no brightness filter. */
  .card:hover {
    border-color: currentColor;
  }

  .card .body {
    color: inherit;
    opacity: 0.92;
  }

  .card .body :global(strong) {
    color: inherit;
  }

  .card a {
    margin-top: auto;
  }
</style>
