---
import { IS_PREVIEW } from '../../lib/preview';
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { breadcrumbSchema, SITE_URL } from '../../lib/jsonld';

const PUBLISHED_PREFIXES = ['ideas/', 'articles/', 'reference/'];

export async function getStaticPaths() {
  const allDocs = await getCollection('docs', (doc) => {
    const isPublishedNamespace = PUBLISHED_PREFIXES.some((prefix) => doc.id.startsWith(prefix));
    return isPublishedNamespace && (IS_PREVIEW || !doc.data.draft);
  });

  return allDocs.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const pageUrl = `${SITE_URL}/docs/${entry.slug}`;
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: SITE_URL },
    { name: 'Docs', url: `${SITE_URL}/docs/all` },
    { name: entry.data.title, url: pageUrl },
  ]),
];
---

<ArticleLayout title={entry.data.title} description={entry.data.description} backHref="/docs/all" backLabel="Back to Overview" jsonLd={jsonLd}>
  <Fragment slot="meta">
    {entry.data.description && <p class="text-lg" style="color: var(--color-text-secondary);">{entry.data.description}</p>}
  </Fragment>
  <Content />
  <Fragment slot="footer">
    <div class="mt-16 pt-8" style="border-top: 1px solid var(--color-border);">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <p class="text-sm" style="color: var(--color-text-secondary);">
          Tags: {entry.data.tags || "None"}
        </p>

        <div class="flex items-center gap-4">
          <a href="/docs/all" class="flex items-center gap-2 transition-colors" style="color: var(--color-accent-secondary);">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
            All Topics
          </a>
        </div>
      </div>
    </div>
  </Fragment>
</ArticleLayout>
