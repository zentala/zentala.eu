---
import { getCollection, type CollectionEntry } from 'astro:content';
import { IS_PREVIEW } from '../../lib/preview';
import Layout from '../../layouts/Layout.astro';
import DisplayTitle from '../../components/DisplayTitle.astro';

// Archive listing derived from the docs collection (E006-T08, IA §9 row 8).
// The former hardcoded pre-frame content duplicated `/`, `/vision` and
// `docs/index.mdx` almost verbatim — cut per the one-argument-one-home rule.
// This page is now a thin index into the site's four dedicated archive
// pages, each of which already lists its own category in full.
const docs = await getCollection('docs', (entry: CollectionEntry<'docs'>) =>
  IS_PREVIEW || !entry.data.draft
);

const countIn = (prefix: string) => docs.filter((entry) => entry.id.startsWith(prefix)).length;

const categories = [
  {
    title: 'The Vision Book',
    description: 'The chapters that make the case for direct democracy and European reform, in reading order.',
    href: '/book',
    count: countIn('book/'),
  },
  {
    title: 'Ideas',
    description: 'Proposals organised by domain — finance, governance, transportation, education and more.',
    href: '/docs/ideas',
    count: countIn('ideas/'),
  },
  {
    title: 'Articles',
    description: 'Standalone essays exploring a single question in depth.',
    href: '/docs/articles',
    count: countIn('articles/'),
  },
  {
    title: 'Reference',
    description: 'Supporting documents cited by the book and the ideas.',
    href: '/docs/reference',
    count: countIn('reference/'),
  },
];
---

<Layout
  title="Complete Overview"
  description="An index of every category on this site — the vision book, ideas by domain, articles and reference material — with a link and count for each."
>
  <div class="container mx-auto max-w-4xl px-4 py-8">
    <DisplayTitle title="Complete Overview" />
    <p class="text-xl mb-12" style="color: var(--color-text-secondary);">
      Every category on the site, with a link and a count. Start at
      <a href="/book" style="color: var(--color-accent-primary); text-decoration: underline;">the book</a>
      if you have not read it yet.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {categories.map((category) => (
        <a href={category.href} class="group block p-6 rounded-lg transition-colors"
           style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);">
          <div class="flex items-baseline justify-between mb-2">
            <h2 class="text-xl font-bold" style="color: var(--color-text-primary);">{category.title}</h2>
            <span class="text-sm" style="color: var(--color-text-secondary);">{category.count}</span>
          </div>
          <p style="color: var(--color-text-secondary);">{category.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
