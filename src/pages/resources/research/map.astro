---
import Layout from '../../../layouts/Layout.astro'
import { researchTopics } from '../../../data/research-topics'
import { conceptGroups } from '../../../data/concept-groups'
import ResearchTopicCard from '../../../components/ResearchTopicCard.astro'

const tierMeta = {
  1: { label: 'Tier 1: Foundational', priority: 'Critical', colorClass: 'tier-1' },
  2: { label: 'Tier 2: Pillar Support', priority: 'High', colorClass: 'tier-2' },
  3: { label: 'Tier 3: Supporting Narratives', priority: 'Medium', colorClass: 'tier-3' },
  4: { label: 'Tier 4: Enrichment', priority: 'Medium-Low', colorClass: 'tier-4' },
} as const

const totalTopics = researchTopics.length
const completedTopics = researchTopics.filter((t) => t.status === 'complete').length

const topicsByTier = ([1, 2, 3, 4] as const).map((tier) => ({
  tier,
  meta: tierMeta[tier],
  topics: researchTopics.filter((t) => t.tier === tier),
  completed: researchTopics.filter((t) => t.tier === tier && t.status === 'complete').length,
}))

const allConcepts = [...new Set(researchTopics.flatMap((t) => t.relatedConcepts))]
const conceptLabelMap = Object.fromEntries(conceptGroups.map((c) => [c.id, c.name]))
---

<Layout title="Research Map" noindex={true}>
  <main class="container mx-auto max-w-7xl px-4 sm:px-6 py-10">
    <!-- Header -->
    <div class="mb-10">
      <p class="text-sm uppercase tracking-widest mb-2" style="color: var(--color-accent-primary);">Research Roadmap</p>
      <h1 class="text-4xl font-bold mb-4" style="font-family: 'Playfair Display', serif; color: var(--color-text-primary);">
        Research Map
      </h1>
      <p class="text-lg max-w-3xl" style="color: var(--color-text-secondary);">
        23 research topics that back the zentala.eu manifest with data, precedents, and analysis.
        Organised by strategic priority — from foundational arguments to enrichment layers.
      </p>
    </div>

    <!-- Progress tracker -->
    <div class="rounded-xl p-6 mb-8" style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);">
      <div class="flex flex-wrap gap-6 items-center justify-between mb-4">
        <div>
          <span class="text-2xl font-bold" style="color: var(--color-text-primary);" id="progress-count">{completedTopics}/{totalTopics}</span>
          <span class="text-sm ml-2" style="color: var(--color-text-secondary);">research topics complete</span>
        </div>
        <div class="flex gap-4 flex-wrap text-sm" style="color: var(--color-text-secondary);">
          {topicsByTier.map(({ meta, topics, completed }) => (
            <span>
              <span class={`tier-badge tier-badge--${meta.colorClass}`}>{meta.priority}</span>
              {' '}{completed}/{topics.length}
            </span>
          ))}
        </div>
      </div>
      <div class="w-full rounded-full h-2" style="background-color: var(--color-border);">
        <div
          class="h-2 rounded-full transition-all duration-500"
          style={`width: ${totalTopics > 0 ? Math.round((completedTopics / totalTopics) * 100) : 0}%; background-color: var(--color-accent-primary);`}
          id="progress-bar"
        ></div>
      </div>
    </div>

    <!-- Filters -->
    <div class="rounded-xl p-5 mb-8" style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);">
      <div class="flex flex-wrap gap-4 items-start">
        <div class="flex-1 min-w-48">
          <input
            type="text"
            id="search-input"
            placeholder="Search topics..."
            class="w-full px-4 py-2 rounded-lg text-sm"
            style="background-color: var(--color-bg-primary); border: 1px solid var(--color-border); color: var(--color-text-primary);"
          />
        </div>

        <div class="flex gap-2 flex-wrap">
          <span class="text-sm self-center" style="color: var(--color-text-secondary);">Effort:</span>
          {['Low', 'Medium', 'High'].map((effort) => (
            <button class="filter-btn" data-filter="effort" data-value={effort} style="border: 1px solid var(--color-border);">
              {effort}
            </button>
          ))}
        </div>

        <div class="flex gap-2 flex-wrap">
          <span class="text-sm self-center" style="color: var(--color-text-secondary);">Tier:</span>
          {[1, 2, 3, 4].map((t) => (
            <button class="filter-btn" data-filter="tier" data-value={String(t)} style="border: 1px solid var(--color-border);">
              T{t}
            </button>
          ))}
        </div>

        <div class="flex gap-2 flex-wrap">
          <span class="text-sm self-center" style="color: var(--color-text-secondary);">Concept:</span>
          {allConcepts.map((concept) => (
            <button class="filter-btn" data-filter="concept" data-value={concept} style="border: 1px solid var(--color-border);">
              {conceptLabelMap[concept] ?? concept}
            </button>
          ))}
        </div>

        <button
          id="clear-filters"
          class="text-sm px-3 py-1.5 rounded-lg hidden"
          style="color: var(--color-accent-primary); border: 1px solid var(--color-accent-primary);"
        >
          Clear filters
        </button>
      </div>

      <div id="active-filters" class="flex flex-wrap gap-2 mt-3 empty:hidden"></div>
    </div>

    <!-- Results count -->
    <p class="text-sm mb-6" style="color: var(--color-text-secondary);" id="results-count">
      Showing all {totalTopics} topics
    </p>

    <!-- Topics by tier -->
    <div id="topics-container">
      {topicsByTier.map(({ tier, meta, topics }) => (
        <section class="tier-section mb-8" data-tier={String(tier)}>
          <button
            class="tier-toggle w-full text-left flex items-center justify-between p-4 rounded-xl mb-3 transition-all"
            data-tier={String(tier)}
            style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);"
          >
            <div class="flex items-center gap-3">
              <span class={`tier-badge tier-badge--${meta.colorClass}`}>{meta.priority}</span>
              <span class="font-semibold text-lg" style="color: var(--color-text-primary);">{meta.label}</span>
              <span class="text-sm" style="color: var(--color-text-secondary);">{topics.length} topics</span>
            </div>
            <span class="tier-chevron text-lg transition-transform" style="color: var(--color-text-secondary);">▾</span>
          </button>

          <div class="tier-content topics-grid" data-tier={String(tier)}>
            {topics.map((topic) => (
              <ResearchTopicCard topic={topic} conceptLabelMap={conceptLabelMap} />
            ))}
          </div>
        </section>
      ))}
    </div>

    <div id="no-results" class="hidden text-center py-16" style="color: var(--color-text-secondary);">
      <p class="text-xl mb-2">No topics match your filters.</p>
      <p class="text-sm">Try adjusting your search or clearing filters.</p>
    </div>
  </main>
</Layout>

<style>
  .tier-badge {
    @apply text-xs font-semibold px-2 py-0.5 rounded-full uppercase tracking-wide;
  }
  .tier-badge--tier-1 { background-color: #fee2e2; color: #991b1b; }
  .tier-badge--tier-2 { background-color: #fed7aa; color: #9a3412; }
  .tier-badge--tier-3 { background-color: #fef08a; color: #713f12; }
  .tier-badge--tier-4 { background-color: #d1fae5; color: #065f46; }

  :global(.dark) .tier-badge--tier-1 { background-color: #7f1d1d; color: #fca5a5; }
  :global(.dark) .tier-badge--tier-2 { background-color: #7c2d12; color: #fdba74; }
  :global(.dark) .tier-badge--tier-3 { background-color: #713f12; color: #fde68a; }
  :global(.dark) .tier-badge--tier-4 { background-color: #064e3b; color: #6ee7b7; }

  .topics-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }

  .filter-btn {
    @apply text-xs px-3 py-1.5 rounded-lg transition-all;
    background-color: var(--color-bg-primary);
    color: var(--color-text-secondary);
  }
  .filter-btn:hover {
    border-color: var(--color-accent-primary) !important;
    color: var(--color-accent-primary);
  }
  .filter-btn.active {
    background-color: var(--color-accent-primary);
    color: #ffffff;
    border-color: var(--color-accent-primary) !important;
  }

  .tier-content.collapsed { display: none; }
  .tier-toggle.collapsed .tier-chevron { transform: rotate(-90deg); }
</style>

<script>
  import '../../../scripts/research-map'
</script>
