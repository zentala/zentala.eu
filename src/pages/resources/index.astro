---
import Layout from '../../layouts/Layout.astro'

const modules = import.meta.glob('./*.md', { eager: true })

const pages = Object.entries(modules)
  .map(([path, mod]: [string, any]) => ({
    slug: path.replace('./', '').replace('.md', ''),
    title: mod.frontmatter.title,
    datetime: mod.frontmatter.datetime,
    description: mod.frontmatter.description,
  }))
  .sort((a, b) => b.datetime.localeCompare(a.datetime))
---

<Layout title="Notatki i zasoby">
  <main class="max-w-3xl mx-auto px-6 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-xs font-mono px-3 py-1 rounded mb-4">
        🔒 SEKCJA ROBOCZA
      </div>
      <h1 class="text-3xl font-bold mb-3" style="font-family: 'Playfair Display', serif">Notatki i zasoby</h1>
      <p class="opacity-60 text-sm">Materiały źródłowe do manifestu. Posortowane od najnowszego.<br>Nie publiczne, nieindeksowane.</p>
    </div>

    <div class="space-y-4">
      <!-- Interactive tools -->
      <a
        href="/resources/research/map"
        class="block p-5 rounded-lg border hover:border-amber-500/40 transition-all group"
        style="border-color: rgba(245,158,11,0.3); background: rgba(245,158,11,0.04);"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="font-semibold opacity-90 mb-1" style="font-family: 'Playfair Display', serif">Research Map</h2>
            <p class="text-sm opacity-50">20 research topics organised by strategic priority — interactive explorer with filters and progress tracking.</p>
          </div>
          <span class="font-mono text-xs opacity-40 whitespace-nowrap mt-1">interactive</span>
        </div>
      </a>

      {pages.map(page => (
        <a
          href={`/resources/${page.slug}`}
          class="block p-5 rounded-lg border hover:border-amber-500/40 transition-all group"
          style="border-color: rgba(128,128,128,0.2)"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-semibold opacity-90 mb-1" style="font-family: 'Playfair Display', serif">{page.title}</h2>
              <p class="text-sm opacity-50">{page.description}</p>
            </div>
            <span class="font-mono text-xs opacity-40 whitespace-nowrap mt-1">{page.datetime.replace('T', ' ')}</span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
