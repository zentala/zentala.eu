---
import Layout from '../../layouts/Layout.astro';
import { getCommentary, formatDate } from '../../lib/commentary';

export async function getStaticPaths() {
  const entries = await getCommentary();
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout
  title={`${entry.data.title} - Commentary`}
  description={entry.data.description}
  markdownAlternate={`/commentary/${entry.slug}.md`}
>
  <div class="container mx-auto max-w-3xl px-4 py-8">
    <a href="/commentary" class="underline" style="color: var(--color-accent-secondary);">&larr; Commentary</a>
    <p class="text-sm theme-text-secondary mt-6">
      By {entry.data.author} · <time datetime={formatDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
      {entry.data.updated && <> · Updated <time datetime={formatDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time></>}
      · {entry.data.topic}
    </p>
    <h1 class="text-4xl font-bold theme-text-primary mt-2 mb-6">{entry.data.title}</h1>
    <article class="prose max-w-none">
      <Content />
    </article>
    <p class="mt-10 theme-text-secondary">
      Source: <a href={entry.data.sourceUrl} class="underline" rel="noopener">{entry.data.sourceTitle}</a> ({entry.data.sourceOutlet})
    </p>
  </div>
</Layout>
