---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCommentary, formatDate } from '../../lib/commentary';
import { articleSchema, breadcrumbSchema, SITE_URL } from '../../lib/jsonld';

export async function getStaticPaths() {
  const entries = await getCommentary();
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const pageUrl = `${SITE_URL}/commentary/${entry.slug}`;
const jsonLd = [
  articleSchema({
    type: 'BlogPosting',
    url: pageUrl,
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.date,
    dateModified: entry.data.updated,
    authorName: entry.data.author,
  }),
  breadcrumbSchema([
    { name: 'Home', url: SITE_URL },
    { name: 'Commentary', url: `${SITE_URL}/commentary` },
    { name: entry.data.title, url: pageUrl },
  ]),
];
---

<ArticleLayout
  title={`${entry.data.title} - Commentary`}
  description={entry.data.description}
  markdownAlternate={`/commentary/${entry.slug}.md`}
  backHref="/commentary"
  backLabel="Commentary"
  jsonLd={jsonLd}
>
  <Fragment slot="meta">
    <p class="text-sm theme-text-secondary">
      By {entry.data.author} · <time datetime={formatDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
      {entry.data.updated && <> · Updated <time datetime={formatDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time></>}
      · {entry.data.topic}
    </p>
  </Fragment>
  <Content />
  <Fragment slot="footer">
    <p class="mt-10 theme-text-secondary">
      Source: <a href={entry.data.sourceUrl} class="underline" rel="noopener">{entry.data.sourceTitle}</a> ({entry.data.sourceOutlet})
    </p>
  </Fragment>
</ArticleLayout>
