---
/**
 * Subscription confirmation page.
 *
 * The newsletter pipeline now lives at hub.zentala.io (Cloudflare Workers).
 * The hub serves a branded HTML confirmation page directly, so the simplest
 * + most correct behaviour is a client-side redirect to the hub endpoint
 * carrying the token. Avoids CORS for HTML and avoids drift between this
 * page's copy and the hub's confirmation UX.
 */
import Layout from "../layouts/Layout.astro";

const HUB_CONFIRM = "https://hub.zentala.io/api/public/newsletter/confirm";
---

<Layout title="Confirm Subscription">
  <div class="container mx-auto max-w-md py-16 px-4">
    <div class="bg-gray-800 rounded-lg shadow-lg p-8 text-center">
      <h1 class="text-3xl font-bold mb-6 text-white">Confirming your subscription</h1>
      <p class="text-gray-300 mb-4" id="status-message">
        Please wait while we hand you over to the confirmation service…
      </p>
      <noscript>
        <p class="text-gray-300 mb-4">
          JavaScript is required to complete the redirect.
          You can also <a id="manual-link" class="text-blue-400 underline"
          href={HUB_CONFIRM}>open the confirmation page manually</a>.
        </p>
      </noscript>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ HUB_CONFIRM }}>
  const token = new URLSearchParams(window.location.search).get('token');
  if (token) {
    window.location.replace(`${HUB_CONFIRM}?token=${encodeURIComponent(token)}`);
  } else {
    const msg = document.getElementById('status-message');
    if (msg) {
      msg.textContent = 'No confirmation token in the URL. Please use the link from your confirmation email.';
    }
  }
</script>
