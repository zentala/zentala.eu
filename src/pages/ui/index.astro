    <!-- Surface / Card base section -->
    <section id="surface" class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6 border-b border-gray-700 pb-2">Surface (base for Card, LayerCard, FAQ)</h2>
      <div class="bg-gray-900/30 border border-gray-700/50 rounded-xl p-6 mb-6">
        <p class="text-gray-400 mb-4">
          <code>Surface</code> owns the <code>--card-&lt;hue&gt;</code> colour lookup and the
          <code>flat</code> / <code>bordered</code> / <code>gradient</code> treatments. Card, LayerCard and the FAQ item all render through it.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {(["flat", "bordered", "gradient"] as const).map((variant) => (
            <div class="space-y-2">
              <p class="text-gray-400 text-sm uppercase tracking-wide">{variant}</p>
              <div class="grid grid-cols-4 gap-2">
