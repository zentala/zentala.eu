      <div class="bg-gray-900/30 border border-gray-700/50 rounded-xl p-6 mb-6">
        <DisplayTitle level={3}>Timeline — compact variant</DisplayTitle>

        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-r from-blue-900 to-indigo-900 opacity-10 blur-xl"></div>
          <div class="relative">
            <Timeline
              variant="compact"
              title="Vision Timeline"
              hue="blue"
              compactItems={[
                { period: "2025-2030", title: "Infrastructure\n& Foundation" },
                { period: "2030-2035", title: "System\nIntegration" },
                { period: "2035-2045", title: "Cultural\nTransformation" }
              ]}
