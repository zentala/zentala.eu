---
/**
 * /manifesto — the most personal page on the site: why it exists at all, the
 * bet behind it, and the one demand it makes of the reader (know what you
 * want). Source: .plan/vision/2026-09-25-direct-democracy-dump.md, parts 3, 4
 * and 8, dictated by Paweł.
 *
 * Shell moved onto ArticleLayout (DESIGN.md Migration step 3, E006-T13): the
 * 52rem frame is gone, the page consumes the 66ch `--article-measure` column
 * through ArticleGrid like every other long-form route. Body colours still
 * come from the .prose token rules in src/styles/global.scss.
 */
import { getEntry } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Lead from '../components/Lead.astro';

const entry = await getEntry('docs', 'manifesto');
const { Content } = await entry.render();
---

<ArticleLayout title="Know what you want" description={entry.data.description} backHref="/vision" backLabel="Back to Vision Overview">
  <Fragment slot="meta">
    <p class="manifesto-eyebrow">A manifesto</p>
    <Lead
      paragraphs={[
        "I am a positivist. I started writing this because everyone around me could tell me what is broken and nobody could tell me what they wanted instead.",
        "This page is my own voice rather than a proposal — why the site exists, what I am betting on, and the one thing I am asking of you.",
      ]}
    />
  </Fragment>
  <Content />
  <Fragment slot="footer">
    <nav class="manifesto-next" aria-label="Continue reading">
      <a class="manifesto-next__link" href="/vision">Read the vision</a>
      <a class="manifesto-next__link" href="/principles">See the principles</a>
    </nav>
  </Fragment>
</ArticleLayout>

<style>
  .manifesto-eyebrow {
    margin-bottom: var(--space-xs);
    color: var(--color-accent-primary);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .manifesto-next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .manifesto-next__link {
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .manifesto-next__link:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }
</style>
