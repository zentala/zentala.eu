---
/**
 * /why — the objections page. The frame (Europe is aging, the pension model
 * ends with generational replacement, thirty years of working economy left) is
 * argued on / and in the frame chapter; this page answers the reader who
 * accepts it and doubts the plan (see .plan/vision/aging-society-frame.md,
 * "Answers to the obvious objections").
 *
 * Layout owns the page's vertical rhythm through the --why-space-* tokens
 * below; the sections themselves consume them (components/why/WhySection).
 */
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DisplayTitle from '../components/DisplayTitle.astro';

const whyEntry = await getEntry('docs', 'why');
const { Content } = await whyEntry.render();
---

<Layout title={whyEntry.data.title} description={whyEntry.data.description}>
  <div class="why-page container mx-auto px-4 sm:px-6 py-10 md:py-16">
    <a href="/vision" class="why-back">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Vision Overview
    </a>

    <header class="why-header">
      <DisplayTitle title="The objections, answered" />
      <p class="why-header__sub">{whyEntry.data.description}</p>
    </header>

    <!-- Heading/paragraph/link colours come from the .prose token rules in
         src/styles/global.scss (theme-aware); no per-page overrides here. -->
    <article class="why-body prose prose-lg max-w-none">
      <Content />
    </article>
  </div>
</Layout>

<style>
  .why-page {
    /* One spacing scale for the whole page — sections, section heads and the
       blocks inside them. WhySection reads these. */
    --why-space-section: 4.5rem;
    --why-space-head: 1.75rem;
    --why-space-block: 2rem;
    max-width: 68rem;
  }

  @media (min-width: 768px) {
    .why-page {
      --why-space-section: 6rem;
      --why-space-head: 2rem;
    }
  }

  .why-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-accent-primary);
  }
  .why-back:hover {
    text-decoration: underline;
  }

  .why-header {
    margin-top: 1.5rem;
    margin-bottom: 3rem;
  }

  .why-header__sub {
    max-width: 70ch;
    margin-top: 1rem;
    font-size: var(--text-xl);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* The first section provides its own top margin; collapse the duplicate. */
  .why-body > :global(section:first-child) {
    margin-top: 0;
  }
  .why-body > :global(section:last-child) {
    margin-bottom: 0;
  }
</style>
