---
/**
 * /why — the objections page. The frame (Europe is aging, the pension model
 * ends with generational replacement, thirty years of working economy left) is
 * argued on / and in the frame chapter; this page answers the reader who
 * accepts it and doubts the plan (see .plan/vision/aging-society-frame.md,
 * "Answers to the obvious objections").
 *
 * Shell moved onto ArticleLayout (DESIGN.md Migration step 3, E006-T13): the
 * 68rem frame is gone, the page consumes the 66ch `--article-measure` column
 * through ArticleGrid like every other long-form route. The body still comes
 * from the docs collection (`why.mdx`) and still renders through
 * `why/WhyAnswer.astro`, which E006-T19 retires when it rewrites the mdx onto
 * `ObjectionList`/`Objection` (DESIGN.md Migration step 3 note; see
 * .plan/BACKLOG.md for the sequencing).
 */
import { getEntry } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Lead from '../components/Lead.astro';

const whyEntry = await getEntry('docs', 'why');
const { Content } = await whyEntry.render();
---

<ArticleLayout title="The objections, answered" description={whyEntry.data.description} backHref="/vision" backLabel="Back to Vision Overview">
  <Fragment slot="meta">
    <Lead paragraphs={[whyEntry.data.description]} />
  </Fragment>
  <Content />
</ArticleLayout>
