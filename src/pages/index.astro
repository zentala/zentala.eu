---
// title: Technocratic Integration Vision for the EU's Future
// description: Technocratic European Integration Vision for the EU's Future
// template: splash
import Hero from '../components/Hero.astro';
import UeLogo from '../assets/eu.png';
import Layout from '../layouts/Layout.astro';
import DisplayTitle from '../components/DisplayTitle.astro';
import Author from '../components/Author.astro';
import WhyDigitalReform from '../components/WhyDigitalReform.astro';
import Newsletter from '../components/Newsletter.astro';
import Button from '../components/Button.astro';

import AIReviewBlurb from '../components/home/AIReviewBlurb.astro';
import Numbers from '../components/home/Numbers.astro';
import QuickLinks from '../components/home/QuickLinks.astro';
import Pillars from '../components/home/Pillars.astro';
import CEEFocus from '../components/home/CEEFocus.astro';
import Benefits from '../components/home/Benefits.astro';
import AdoptionWaves from '../components/home/AdoptionWaves.astro';
import NotProposing from '../components/home/NotProposing.astro';
import FAQSection from '../components/home/FAQSection.astro';
---

<Layout title="Home">

  <Hero
    title="We are the last generation of the European demographic peak."
    description={[
      "The robotic system of public services and care that we build today is our pension system tomorrow. There is no other.",
      "I am Paweł Żentała — a Polish software architect. I look at Europe the way an engineer looks at a system in need of refactoring. This is what I propose."
    ]}
    image={{ file: UeLogo.src }}
    actions={[
      { text: "Read the principles", link: "/principles", variant: "primary" },
      { text: "About the author", link: "/about", variant: "secondary" }
    ]}
  />

  <AIReviewBlurb />

  <Numbers />

  <QuickLinks />

  <div class="py-10 mb-16 transition-colors duration-300" style="background: var(--color-bg-primary); border-top: 1px solid var(--color-border);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 my-20">
      <div class="relative mb-8">
        <div class="absolute inset-0 -mt-8 bg-gradient-to-r from-blue-700/10 via-blue-700/20 to-blue-700/10 blur-2xl opacity-50 rounded-3xl"></div>
        <div class="relative">
          <DisplayTitle level={1}>Why Digital Reform Is Necessary</DisplayTitle>
        </div>
      </div>

      <div class="relative">
        <div class="absolute inset-0 bg-gradient-to-r from-teal-900 to-blue-900 opacity-10 blur-xl"></div>
        <div class="relative">
          <WhyDigitalReform color="teal" />
        </div>
      </div>

      <div class="mt-8 text-center">
        <Button
          href="/why"
          variant="primary"
          size="lg"
          class="bg-gradient-to-r from-teal-600 to-blue-600 hover:from-teal-500 hover:to-blue-500 shadow-md hover:shadow-lg"
        >
          Learn more about why reform is needed
          <i class="fa-solid fa-arrow-right ml-2"></i>
        </Button>
      </div>
    </div>
  </div>

  <Pillars />

  <CEEFocus />

  <Benefits />

  <AdoptionWaves />

  <NotProposing />

  <FAQSection />

  <div class="py-10 mb-16 transition-colors duration-300" style="background: var(--color-bg-primary); border-top: 1px solid var(--color-border);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 my-16">
      <DisplayTitle level={1}>About the Author</DisplayTitle>

      <div class="relative">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-900 to-purple-900 opacity-10 blur-xl"></div>
        <div class="relative">
          <Author color="purple" />
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 my-10">
      <DisplayTitle level={1}>Stay Updated</DisplayTitle>
      <Newsletter />
    </div>
  </div>

</Layout>
