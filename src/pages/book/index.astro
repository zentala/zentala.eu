---
import { IS_PREVIEW } from '../../lib/preview';
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { LAYERS, type Layer } from '../../content/config';
import { bookSeriesSchema, breadcrumbSchema, SITE_URL } from '../../lib/jsonld';

// `book` is the URL segment (routes stay `/book/<slug>`, D3); the reader-facing
// label is "Chapters" everywhere on this page (IA §2.1).

// Chapters come from the content collection, so an unpublished draft can never
// appear here as a link that 404s in production.
const chapters = await getCollection('docs', (entry: CollectionEntry<'docs'>) => {
  const isBook = entry.id.startsWith('book/') && !entry.id.includes('.sidecar');
  return isBook && (IS_PREVIEW || !entry.data.draft);
});

interface BookDoc {
  slug: string;
  title: string;
  description?: string;
  kind?: CollectionEntry<'docs'>['data']['kind'];
  order?: number;
}

function toBookDoc(entry: CollectionEntry<'docs'>): BookDoc {
  return {
    slug: entry.slug.replace(/^book\//, ''),
    title: entry.data.title,
    description: entry.data.description,
    kind: entry.data.kind,
    order: entry.data.order,
  };
}

// Reading order inside a layer: `order` first, ties broken by title (IA §2.4).
function sortByOrder(docs: BookDoc[]): BookDoc[] {
  return [...docs].sort((a, b) => {
    if (a.order !== undefined && b.order !== undefined) return a.order - b.order;
    if (a.order !== undefined) return -1;
    if (b.order !== undefined) return 1;
    return a.title.localeCompare(b.title);
  });
}

const LAYER_LABELS: Record<Layer, string> = {
  frame: 'The frame',
  language: 'Floor — one working language',
  digital: 'Middle — the digital state',
  robotics: 'Ceiling — robotics',
  path: 'How we get there',
};

const KIND_LABELS: Record<string, string> = {
  argument: 'Argument',
  proposal: 'Proposal',
  playbook: 'Playbook',
  objections: 'Objections',
  manifesto: 'Manifesto',
};

const byLayer = new Map<Layer | 'unsorted', BookDoc[]>();
for (const entry of chapters) {
  const key: Layer | 'unsorted' = entry.data.layer ?? 'unsorted';
  byLayer.set(key, [...(byLayer.get(key) ?? []), toBookDoc(entry)]);
}

// A new chapter is visible by default: it lands in "Unsorted" until classified,
// rather than silently disappearing from a hand-kept slug list.
const groupedDocs = [...LAYERS, 'unsorted' as const]
  .map((key) => ({
    key,
    title: key === 'unsorted' ? 'Unsorted' : LAYER_LABELS[key],
    docs: sortByOrder(byLayer.get(key) ?? []),
  }))
  .filter((group) => group.docs.length > 0);

const startChapter = groupedDocs[0]?.docs[0];

const jsonLd = [
  bookSeriesSchema(
    groupedDocs.flatMap((group) => group.docs.map((doc) => ({ name: doc.title, url: `${SITE_URL}/book/${doc.slug}` })))
  ),
  breadcrumbSchema([
    { name: 'Home', url: SITE_URL },
    { name: 'Chapters', url: `${SITE_URL}/book` },
  ]),
];
---

<Layout title="Chapters" description="Every chapter of the EU Reform Vision, grouped by layer and in reading order." jsonLd={jsonLd}>
  <div class="min-h-screen">
    <div class="container mx-auto max-w-6xl px-4 py-8">
      <div class="mb-8">
        <a href="/vision" class="flex items-center gap-2 mb-4 transition-colors" style="color: var(--color-accent-secondary);">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Vision Overview
        </a>
        <h1 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--color-text-primary);">Chapters</h1>
        <p class="text-xl" style="color: var(--color-text-secondary);">
          Every chapter, grouped by layer and in reading order. The argument in full is at <a href="/vision" style="color: var(--color-accent-primary);">/vision</a>.
        </p>
      </div>

      {startChapter && (
        <div class="relative mb-12">
          <div class="absolute inset-0 opacity-50 blur-xl transition-colors duration-300" style="background: linear-gradient(to right, var(--color-accent-primary), var(--color-accent-secondary));"></div>
          <div class="relative rounded-xl p-8 shadow-lg transition-colors duration-300" style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);">
            <h2 class="text-2xl font-bold mb-4" style="color: var(--color-text-primary);">Start here</h2>
            <p class="mb-6" style="color: var(--color-text-secondary);">Europe is aging, and its pension model was built on generational replacement that no longer happens. These chapters lay out a thirty-year window to build what replaces it: one working language, a digital state, and robotics on top of both.</p>

            <div class="flex flex-wrap gap-3">
              <a href={`/book/${startChapter.slug}`} class="px-4 py-2 rounded-lg text-sm transition-colors" style="background-color: var(--color-accent-primary); color: var(--color-bg-primary);">
                Start with the frame: {startChapter.title}
              </a>
            </div>
          </div>
        </div>
      )}

      {groupedDocs.map((group) => (
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text-primary);">{group.title}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.docs.map(doc => (
              <a href={`/book/${doc.slug}`} class="group">
                <div class="rounded-lg p-6 transition-all duration-300 h-full border flex flex-col" style="background-color: var(--color-bg-secondary); border-color: var(--color-border);">
                  {doc.kind && <span class="text-xs uppercase mb-2" style="color: var(--color-text-secondary); letter-spacing: var(--tracking-eyebrow);">{KIND_LABELS[doc.kind] ?? doc.kind}</span>}
                  <h3 class="text-xl font-semibold mb-2 transition-colors" style="color: var(--color-text-primary);">{doc.title}</h3>
                  {doc.description && (
                    <p class="text-sm mb-4 flex-grow" style="color: var(--color-text-secondary);">{doc.description}</p>
                  )}
                  <div class="flex justify-between items-center mt-2">
                    <span class="text-sm" style="color: var(--color-accent-primary);">Read chapter</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform" style="color: var(--color-accent-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}

      <div class="mt-8 flex justify-between items-center">
        <a href="/vision" class="flex items-center gap-2 transition-colors" style="color: var(--color-accent-secondary);">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          Vision Overview
        </a>

        <a href="/why" class="inline-flex items-center gap-2 font-medium px-4 py-2 rounded-lg transition-all" style="background-color: var(--color-accent-primary); color: var(--color-bg-primary);">
          Why Reform EU?
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</Layout>
