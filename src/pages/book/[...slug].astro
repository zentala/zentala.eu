---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const documents = await getCollection('docs', (entry) => !entry.data.draft);
  return documents
    .filter((entry) => entry.id.startsWith('book/'))
    .map((entry) => ({
      params: { slug: entry.id.replace(/^book\//, '').replace(/\.mdx?$/, '') },
      props: { entry }
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
  <main class="container mx-auto max-w-6xl px-4 py-8">
    <a href="/book" class="text-blue-400 hover:text-blue-300">← Back to the Vision Book</a>
    <h1 class="text-4xl md:text-5xl font-bold text-white mt-8 mb-4">{entry.data.title}</h1>
    <p class="text-xl text-gray-300 mb-8">{entry.data.description}</p>
    <article class="prose prose-lg max-w-none dark:prose-invert prose-headings:text-white prose-p:text-gray-300 prose-a:text-blue-400 prose-strong:text-white prose-code:text-blue-300 prose-pre:bg-gray-800 prose-pre:text-gray-300 prose-li:text-gray-300">
      <Content />
    </article>
  </main>
</Layout>
