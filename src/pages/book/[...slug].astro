---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { IS_PREVIEW } from '../../lib/preview';
import { articleSchema, breadcrumbSchema, SITE_URL } from '../../lib/jsonld';

export async function getStaticPaths() {
  const documents = await getCollection('docs', (entry: CollectionEntry<'docs'>) => IS_PREVIEW || !entry.data.draft);
  return documents
    .filter((entry: CollectionEntry<'docs'>) => entry.id.startsWith('book/'))
    .map((entry: CollectionEntry<'docs'>) => ({
      params: { slug: entry.id.replace(/^book\//, '').replace(/\.mdx?$/, '') },
      props: { entry }
    }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'docs'> };
const { Content } = await entry.render();
const slug = entry.id.replace(/^book\//, '').replace(/\.mdx?$/, '');
const publishedDate = entry.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedDate = entry.data.updated?.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const pageUrl = `${SITE_URL}/book/${slug}`;
const jsonLd = [
  articleSchema({
    type: 'Article',
    url: pageUrl,
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.date,
    dateModified: entry.data.updated,
    authorName: entry.data.author,
  }),
  breadcrumbSchema([
    { name: 'Home', url: SITE_URL },
    { name: 'Book', url: `${SITE_URL}/book` },
    { name: entry.data.title, url: pageUrl },
  ]),
];
---

<ArticleLayout title={entry.data.title} description={entry.data.description} markdownAlternate={`/book/${slug}.md`} backHref="/book" backLabel="Back to the Vision Book" jsonLd={jsonLd}>
  <Fragment slot="meta">
    <p class="text-sm mb-4" style="color: var(--color-text-secondary);">
      By {entry.data.author} · <time datetime={entry.data.date.toISOString()}>{publishedDate}</time>
      {updatedDate && <> · Updated <time datetime={entry.data.updated!.toISOString()}>{updatedDate}</time></>}
    </p>
    <p class="text-lg" style="color: var(--color-text-secondary);">{entry.data.description}</p>
  </Fragment>
  <Content />
</ArticleLayout>
