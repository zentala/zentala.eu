---
/**
 * /glossary — every governed term, grouped by the layer of its canonical
 * home (IA §7 step 4). A book chapter's layer comes from its own
 * frontmatter; a top-level href (e.g. /vision) that is not a book chapter
 * falls into "Pages". Status is shown for every entry, per IA §7.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DisplayTitle from '../components/DisplayTitle.astro';
import Section from '../components/Section.astro';
import { LAYERS, type Layer } from '../content/config';
import { IS_PREVIEW } from '../lib/preview';

const LAYER_LABELS: Record<Layer, string> = {
  frame: 'The frame',
  language: 'Floor — one working language',
  digital: 'Middle — the digital state',
  robotics: 'Ceiling — robotics',
  path: 'How we get there',
};

const STATUS_LABELS: Record<string, string> = {
  defined: 'Defined',
  'needs-definition': 'Needs definition',
  external: 'Defined outside this site',
};

const entries = await getCollection('glossary');
const chapters = await getCollection('docs', (entry: CollectionEntry<'docs'>) => {
  return entry.id.startsWith('book/') && (IS_PREVIEW || !entry.data.draft);
});

/** Maps a book chapter's file id to its public /book/<slug> route. */
function chapterHref(entry: CollectionEntry<'docs'>): string {
  return `/book/${entry.id.replace(/^book\//, '').replace(/\.mdx?$/, '')}`;
}

const layerByChapterHref = new Map<string, Layer>();
for (const chapter of chapters) {
  if (chapter.data.layer) layerByChapterHref.set(chapterHref(chapter), chapter.data.layer);
}

type Group = { key: Layer | 'pages'; title: string; entries: typeof entries };

function groupKeyFor(href: string): Layer | 'pages' {
  const path = href.split('#')[0];
  return layerByChapterHref.get(path) ?? 'pages';
}

const byGroup = new Map<Layer | 'pages', typeof entries>();
for (const entry of entries) {
  const key = groupKeyFor(entry.data.href);
  byGroup.set(key, [...(byGroup.get(key) ?? []), entry]);
}

const groups: Group[] = [...LAYERS, 'pages' as const]
  .map((key) => ({
    key,
    title: key === 'pages' ? 'Pages' : LAYER_LABELS[key],
    entries: (byGroup.get(key) ?? []).sort((a, b) => a.data.term.localeCompare(b.data.term)),
  }))
  .filter((g) => g.entries.length > 0);

const total = entries.length;
---

<Layout
  title="Glossary"
  description={`The ${total} governed terms this site uses precisely and defines once, grouped by where each one is argued.`}
>
  <div class="container mx-auto max-w-4xl px-4 py-8">
    <DisplayTitle title={`Glossary — ${total} terms`} />
    <p class="mb-12" style="color: var(--color-text-secondary); font-size: var(--text-lg);">
      Every governed term on this site, in one place. Each is defined once and linked from
      wherever it is used first on a page.
    </p>

    {
      groups.map((group) => (
        <Section title={group.title} id={group.key}>
          <dl class="glossary-list">
            {group.entries.map((entry) => (
              <div class="glossary-list__item" id={entry.slug}>
                <dt class="glossary-list__term">
                  {entry.data.term}
                  <span class="glossary-list__status" data-status={entry.data.status}>
                    {STATUS_LABELS[entry.data.status]}
                  </span>
                </dt>
                <dd class="glossary-list__body">
                  {entry.data.definition && <p>{entry.data.definition}</p>}
                  {entry.body && <p class="glossary-list__long">{entry.body}</p>}
                  <p>
                    <a href={entry.data.href}>Read where it is argued →</a>
                  </p>
                </dd>
              </div>
            ))}
          </dl>
        </Section>
      ))
    }
  </div>
</Layout>

<style>
  .glossary-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .glossary-list__term {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .glossary-list__status {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .glossary-list__body {
    margin: 0.5rem 0 0;
    color: var(--color-text-secondary);
  }

  .glossary-list__body p {
    margin: 0 0 0.5rem;
  }

  .glossary-list__long {
    color: var(--color-text-primary);
  }

  .glossary-list__body a {
    color: var(--color-accent-primary);
    text-decoration: underline;
  }
</style>
