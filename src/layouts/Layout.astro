---
import '../styles/fonts.scss'
import '../styles/global.scss'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import JsonLd from '../components/seo/JsonLd.astro'
import { IS_PREVIEW } from '../lib/preview'
import { siteGraph } from '../lib/jsonld'

interface Props {
  title: string
  description?: string
  canonical?: string
  ogImage?: string
  noindex?: boolean
  type?: 'website' | 'article'
  markdownAlternate?: string
  /** Extra JSON-LD graphs (Article/BlogPosting, BreadcrumbList, series...) beyond the site-wide WebSite + Person. */
  jsonLd?: Record<string, unknown>[]
}

const SITE_NAME = 'EU Reform Vision'
const DEFAULT_DESCRIPTION =
  'A comprehensive vision for European integration through technology, language, and infrastructure.'
const DEFAULT_OG_IMAGE = '/og-default.png'

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  noindex = false,
  type = 'website',
  markdownAlternate,
  jsonLd = [],
} = Astro.props

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site)
const ogImageUrl = new URL(ogImage, Astro.site)
const markdownAlternateUrl = markdownAlternate ? new URL(markdownAlternate, Astro.site) : undefined
// Preview (eu.internal) must never be indexed, whatever the page asks for.
const shouldNoindex = noindex || IS_PREVIEW
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121419" />
    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {markdownAlternateUrl && <link rel="alternate" type="text/markdown" href={markdownAlternateUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Self-hosted body font (Inter Variable, latin subset covers ASCII). font-display: swap
         is set in the @font-face rules imported from src/styles/fonts.scss. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin-standard-normal.woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {SITE_NAME}</title>

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={`${title} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <JsonLd graphs={[...siteGraph(), ...jsonLd]} />

    <script is:inline>
      // Theme management script
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        // No stored choice yet: follow the OS/browser preference. Colours now
        // come from theme tokens (src/styles/_tokens.scss) with matching
        // light/dark values, so either theme renders correctly by default.
        if (typeof window !== 'undefined' && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#main" class="skip-link">Skip to main content</a>
    <div class="fixed inset-0 z-[-1] opacity-50 transition-colors duration-300 bg-gradient-to-b" style={{
      backgroundImage: `linear-gradient(to bottom, var(--color-bg-gradient-from), var(--color-bg-gradient-to))`
    }}></div>
    <Header />
    <main id="main" class="py-6 px-0">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style is:global>
  html {
    font-family: var(--font-sans);
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* DESIGN.md Typography → Scale: display/H1/H2/H3 stay serif; H4-H6 are
     Inter 600, not serif — this rule used to set serif on all six levels. */
  h1, h2, h3 {
    font-family: var(--font-serif);
  }

  h4, h5, h6 {
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background-color: var(--color-accent-primary);
    color: var(--color-bg-primary);
    border-radius: 0 0 var(--radius-md) 0;
  }

  .skip-link:focus {
    top: 0;
  }

  /* Global focus-visible ring, token-driven so it holds in both themes. */
  :focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }
  
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
  
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 12px;
  }
  
  ::-webkit-scrollbar-track {
    background: var(--color-scrollbar-track);
    transition: background-color 0.3s;
  }
  
  ::-webkit-scrollbar-thumb {
    background: var(--color-scrollbar-thumb);
    border-radius: 6px;
    transition: background-color 0.3s;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-scrollbar-thumb-hover);
  }
</style>