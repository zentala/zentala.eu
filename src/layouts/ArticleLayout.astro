---
/**
 * Shared long-form article shell for book, docs, commentary and transcripts
 * `[...slug].astro` routes (E004-T02). Wraps the site Layout and constrains
 * the prose column to an editorial reading measure (62-72ch at 18-19px body
 * text), instead of every route inventing its own container width.
 *
 * The route still renders its own single `<h1>{title}</h1>` here; markdown
 * source files must not repeat the title as a `# Heading` (E004-T02
 * acceptance: exactly one h1 per rendered page).
 */
import Layout from './Layout.astro'
import ArticleGrid from '../components/ArticleGrid.astro'

interface Props {
  title: string
  description?: string
  canonical?: string
  ogImage?: string
  noindex?: boolean
  /** Path to the Markdown twin of this page, e.g. "/book/slug.md" (E004-T08). */
  markdownAlternate?: string
  /** Link back to the collection index, e.g. "/book". */
  backHref: string
  backLabel: string
  /**
   * Transcripts pair the body with a sticky sidebar (video info, key
   * points): the body column there is wider than the editorial measure.
   * Default false keeps the 62-72ch measure for book/docs/commentary.
   */
  wideBody?: boolean
  /** Extra JSON-LD graphs (Article/BlogPosting, BreadcrumbList...) for this page. */
  jsonLd?: Record<string, unknown>[]
}

const { title, description, canonical, ogImage, noindex, markdownAlternate, backHref, backLabel, wideBody = false, jsonLd = [] } = Astro.props
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} markdownAlternate={markdownAlternate} type="article" jsonLd={jsonLd}>
  <div class="container mx-auto px-4 py-8">
    <ArticleGrid>
      <a href={backHref} class="back-link transition-colors" style="color: var(--color-accent-secondary);">
        &larr; {backLabel}
      </a>
      <header class="article-header">
        <h1 class="article-title">{title}</h1>
        <slot name="meta" />
      </header>
      <div class:list={['article-body-wrap', { 'span-full': wideBody }]}>
        <article class="prose prose-lg article-body">
          <slot />
        </article>
      </div>
      <slot name="footer" />
    </ArticleGrid>
  </div>
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    text-wrap: balance;
    margin: 0 0 1rem;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: var(--text-5xl);
    }
  }
</style>
